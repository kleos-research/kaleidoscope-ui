node_modules/
dist/
coverage/
.DS_Store
*.log

# Local vaults and scratch space. A vault in this tree is the one leak no text scanner catches,
# so it is ignored by name and by shape before anyone has the chance to add one.
.kaleidoscope/
*-vault/
vault/
scratch/
tmp/
fixtures/generated/

# Screenshots are taken against a real vault, so they contain real memory content.
# They are useful locally and must never be published from this repository.
docs/screenshots/

# Written by the build: which third-party packages actually landed in dist/. It is the input to
# scripts/third-party-notices.mjs, and it is derived, so it is not committed.
.bundled-packages.json

# npm pack output, written here by the release test and by a hand-run pack.
*.tgz

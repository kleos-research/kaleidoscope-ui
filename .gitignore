node_modules/
dist/
coverage/
.DS_Store
*.log

# Local vaults and scratch space. A vault in this tree is the one leak no text scanner catches,
# so it is ignored by name and by shape before anyone has the chance to add one.
.kaleidoscope/
*-vault/
vault/
scratch/
tmp/
fixtures/generated/

# Screenshots are taken against a real vault, so they contain real memory content.
# They are useful locally and must never be published from this repository.
docs/screenshots/

# Written by the build: which third-party packages actually landed in dist/. It is the input to
# scripts/third-party-notices.mjs, and it is derived, so it is not committed.
.bundled-packages.json

# npm pack output, written here by the release test and by a hand-run pack.
*.tgz

# Design canvas build output; the .dc.html sources beside it are the spec and ARE tracked.
#
# Matched by suffix rather than spelled in full ON PURPOSE. The boundary gate refuses any name under
# this project's namespace that is not a public repository, and it cannot tell a sibling private
# repo from a local build artefact that happens to be named after one — so the full filename here
# read as a disclosure and turned the gate red over a line in .gitignore. The pattern below ignores
# exactly the same file and names no namespace.
design/*-memory-ui.html

# Local working notes from the pre-publication review. They are not documentation, so they are
# ignored by name and cannot be committed by accident.
docs/PUBLIC-READINESS.md
docs/history-audit.md
